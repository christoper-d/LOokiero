---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getPath } from '../utils/paths';
---

<Layout title="LOokiero! Tienda de Regalos y Accesorios">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="site-container hero-container">
      <div class="hero-content">
        <span class="hero-badge">✨ Bienvenido a LOokiero!</span>
        <h1 class="hero-title">Tienda de regalos <br /> <span>y accesorios</span></h1>
        <p class="hero-slogan">"No dejes de hacer felices a los que más quieres"</p>
        <div class="hero-buttons">
          <a href="#temporada" class="btn-lookiero">Ver novedades</a>
          <a href={getPath('/hombres')} class="btn-hero-outline">Explorar catálogo</a>
        </div>
      </div>
    </div>
  </section>

  <div class="site-container">
    <!-- Banner de Temporada -->
    <section class="season-banner" id="temporada">
      <div class="season-content">
        <span class="season-tag">🎃 Colección Especial</span>
        <h2>Especial de Halloween</h2>
        <p>Los mejores detalles, linternas y adornos temáticos para sorprender a todos.</p>
        <a href="#temporada-productos" class="btn-lookiero">Descubrir ofertas</a>
      </div>
    </section>

    <!-- Productos de Temporada -->
    <section class="section-wrapper" id="temporada-productos">
      <h2 class="section-title"><i class='bx bxs-gift'></i> Por Temporada</h2>
      <p class="section-subtitle">Edición limitada por fechas especiales</p>
      <div class="products-grid">
        <ProductCard
          title="Recipiente de calabaza"
          price="S/ 25.00"
          image="/img/products/temporada/calabaza1.jpg"
          rating="★★★★☆"
          promo="5%"
          category="Temporada"
        />
        <ProductCard
          title="Esqueleto colgante decorativo"
          price="S/ 30.00"
          image="/img/products/temporada/calabera1.jpg"
          rating="★★★★★"
          category="Temporada"
        />
        <ProductCard
          title="Linterna calavera mística"
          price="S/ 35.00"
          image="/img/products/temporada/linterna-cala1.jpeg"
          rating="★★★★☆"
          category="Temporada"
        />
        <ProductCard
          title="Escultura decorativa temática"
          price="S/ 40.00"
          image="/img/products/temporada/escultura1.jpeg"
          rating="★★★★★"
          category="Temporada"
        />
      </div>
    </section>

    <!-- Tendencias -->
    <section class="section-wrapper">
      <h2 class="section-title"><i class='bx bxs-hot'></i> Tendencias</h2>
      <p class="section-subtitle">Los productos más buscados de esta semana</p>
      <div class="products-grid">
        <ProductCard
          title="Billetera de cuero elegante"
          price="S/ 50.00"
          image="/img/products/hombre/producto3h.jpg"
          rating="★★★★★"
          category="Hombre"
        />
        <ProductCard
          title="Peluche Pablo Backyardigan"
          price="S/ 25.00"
          image="/img/products/ninhos/producto1n.jpg"
          rating="★★★★★"
          category="Niños"
        />
        <ProductCard
          title="Pulseras artesanales finas"
          price="S/ 5.00"
          image="/img/products/mujer/pulsera-1.png"
          rating="★★★★★"
          category="Mujer"
        />
        <ProductCard
          title="Reloj ejecutivo moderno"
          price="S/ 25.00"
          image="/img/products/hombre/producto1h.jpg"
          rating="★★★★★"
          category="Hombre"
        />
        <ProductCard
          title="Peluche burro tierno"
          price="S/ 25.00"
          image="/img/products/ninhos/producto7n.jpg"
          rating="★★★★★"
          category="Niños"
        />
      </div>
    </section>

    <!-- Promociones -->
    <section class="section-wrapper">
      <h2 class="section-title"><i class='bx bxs-discount'></i> Promociones Imperdibles</h2>
      <p class="section-subtitle">Descuentos especiales por tiempo limitado</p>
      <div class="products-grid">
        <ProductCard
          title="Brazalete de plata brillante"
          price="S/ 45.00"
          image="/img/products/mujer/brazalete.png"
          rating="★★★★★"
          promo="15%"
          category="Mujer"
        />
        <ProductCard
          title="Collar dije de flecha"
          price="S/ 15.00"
          image="/img/products/hombre/producto2h.jpg"
          rating="★★★★★"
          promo="5%"
          category="Hombre"
        />
        <ProductCard
          title="Pulsera tribal tejida"
          price="S/ 15.00"
          image="/img/products/hombre/producto5h.jpg"
          rating="★★★★★"
          promo="2%"
          category="Hombre"
        />
        <ProductCard
          title="Aretes de diseño exclusivo"
          price="S/ 40.00"
          image="/img/products/mujer/aretes.jpg"
          rating="★★★★★"
          promo="10%"
          category="Mujer"
        />
        <ProductCard
          title="Set creativo de pinturas"
          price="S/ 20.00"
          image="/img/products/ninhos/producto6n.jpg"
          rating="★★★★★"
          promo="5%"
          category="Niños"
        />
      </div>
    </section>

    <!-- Acceso Rápido por Categorías -->
    <section class="categories-preview">
      <h2 class="section-title"><i class='bx bx-grid-alt'></i> Categorías</h2>
      <div class="category-cards-grid">
        <a href={getPath('/hombres')} class="cat-card">
          <i class='bx bx-male'></i>
          <h3>Hombres</h3>
          <p>Relojes, billeteras y accesorios</p>
        </a>
        <a href={getPath('/mujeres')} class="cat-card">
          <i class='bx bx-female'></i>
          <h3>Mujeres</h3>
          <p>Joyería, pulseras y anillos</p>
        </a>
        <a href={getPath('/ninhos')} class="cat-card">
          <i class='bx bx-smile'></i>
          <h3>Niños</h3>
          <p>Peluches y juguetes didácticos</p>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding: 70px 0 50px 0;
  }

  .hero-container {
    display: flex;
    align-items: center;
  }

  .hero-badge {
    display: inline-block;
    background: #fdf2ef;
    color: #DF7861;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 15px;
    border: 1px solid rgba(223, 120, 97, 0.2);
  }

  .hero-title {
    font-size: 3.4rem;
    font-weight: 800;
    color: #3e1908;
    line-height: 1.15;
    margin-bottom: 15px;
    letter-spacing: -1px;
  }

  .hero-title span {
    color: #DF7861;
  }

  .hero-slogan {
    font-size: 1.15rem;
    color: #64748b;
    margin-bottom: 30px;
    font-style: italic;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .btn-hero-outline {
    display: inline-block;
    padding: 10px 24px;
    color: #3e1908;
    background: transparent;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 20px;
    border: 2px solid #3e1908;
    transition: all 0.3s ease;
  }

  .btn-hero-outline:hover {
    background: #3e1908;
    color: white;
  }

  /* Banner de temporada */
  .season-banner {
    background: linear-gradient(135deg, #4a3e3d 0%, #2b2024 100%), url('/img/fondos/fondo6.jpg');
    background-blend-mode: overlay;
    background-size: cover;
    background-position: center;
    border-radius: 24px;
    padding: 45px 35px;
    color: white;
    margin: 40px 0 30px 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .season-content {
    max-width: 500px;
  }

  .season-tag {
    background: #f59e0b;
    color: #1f100a;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    display: inline-block;
    margin-bottom: 12px;
  }

  .season-content h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .season-content p {
    color: #cbd5e1;
    font-size: 1rem;
    margin-bottom: 22px;
    line-height: 1.5;
  }

  .section-wrapper {
    margin: 40px 0;
  }

  /* Categorías preview */
  .categories-preview {
    margin: 50px 0 30px 0;
  }

  .category-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .cat-card {
    background: white;
    border-radius: 18px;
    padding: 25px 20px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: all 0.3s ease;
  }

  .cat-card:hover {
    transform: translateY(-5px);
    border-color: #DF7861;
    box-shadow: 0 10px 25px rgba(223, 120, 97, 0.15);
  }

  .cat-card i {
    font-size: 2.5rem;
    color: #DF7861;
    margin-bottom: 10px;
  }

  .cat-card h3 {
    font-size: 1.2rem;
    color: #3e1908;
    margin-bottom: 6px;
  }

  .cat-card p {
    font-size: 0.85rem;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.4rem;
    }
    .season-content h2 {
      font-size: 1.7rem;
    }
    .category-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
