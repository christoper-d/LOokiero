---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getPath } from '../utils/paths';
---

<Layout title="LOokiero! Tienda de Regalos y Accesorios">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="site-container hero-container">
      <div class="hero-content">
        <span class="hero-badge"><i class='bx bx-sparkles'></i> Bienvenido a LOokiero!</span>
        <h1 class="hero-title">Tienda de regalos <br /> <span>y accesorios</span></h1>
        <p class="hero-slogan">"No dejes de hacer felices a los que más quieres"</p>
        <div class="hero-buttons">
          <a href="#temporada" class="btn-lookiero">Ver novedades</a>
          <a href={getPath('/hombres')} class="btn-hero-outline">Explorar catálogo</a>
        </div>
      </div>
    </div>
  </section>

  <div class="site-container">
    <!-- Banner de Temporada -->
    <section class="season-banner" id="temporada" style={`background-image: linear-gradient(135deg, rgba(74, 62, 61, 0.9) 0%, rgba(43, 32, 36, 0.95) 100%), url('${getPath('/img/fondos/fondo6.jpg')}');`}>
      <div class="season-content">
        <span class="season-tag"><i class='bx bx-calendar-star'></i> Colección Especial</span>
        <h2>Especial de Halloween</h2>
        <p>Los mejores detalles, linternas y adornos temáticos para sorprender a todos.</p>
        <a href="#temporada-productos" class="btn-lookiero">Descubrir ofertas</a>
      </div>
    </section>

    <!-- Colección Por Temporada -->
    <section class="collection-block temporada-block" id="temporada-productos">
      <div class="collection-header">
        <div class="header-left">
          <span class="collection-badge"><i class='bx bx-calendar-event'></i> Edición Especial</span>
          <h2 class="collection-title"><i class='bx bx-gift'></i> Por Temporada</h2>
          <p class="collection-subtitle">Artículos exclusivos y temáticos seleccionados por fechas especiales</p>
        </div>
        <div class="header-right">
          <span class="collection-chip"><i class='bx bx-check-shield'></i> Stock Limitado</span>
        </div>
      </div>
      <div class="products-grid">
        <ProductCard
          title="Recipiente de calabaza"
          price="S/ 25.00"
          image="/img/products/temporada/calabaza1.jpg"
          rating="★★★★☆"
          promo="5%"
          category="Temporada"
        />
        <ProductCard
          title="Esqueleto colgante decorativo"
          price="S/ 30.00"
          image="/img/products/temporada/calabera1.jpg"
          rating="★★★★★"
          category="Temporada"
        />
        <ProductCard
          title="Linterna calavera mística"
          price="S/ 35.00"
          image="/img/products/temporada/linterna-cala1.jpeg"
          rating="★★★★☆"
          category="Temporada"
        />
        <ProductCard
          title="Escultura decorativa temática"
          price="S/ 40.00"
          image="/img/products/temporada/escultura1.jpeg"
          rating="★★★★★"
          category="Temporada"
        />
      </div>
    </section>

    <!-- Colección Tendencias -->
    <section class="collection-block tendencias-block">
      <div class="collection-header">
        <div class="header-left">
          <span class="collection-badge badge-trend"><i class='bx bx-trending-up'></i> Lo Más Popular</span>
          <h2 class="collection-title"><i class='bx bx-flame'></i> Tendencias</h2>
          <p class="collection-subtitle">Los productos y accesorios favoritos más pedidos de esta semana</p>
        </div>
        <div class="header-right">
          <a href={getPath('/hombres')} class="collection-action-link">
            Ver catálogo completo <i class='bx bx-right-arrow-alt'></i>
          </a>
        </div>
      </div>

      <!-- Filtro rápido de categorías para Tendencias -->
      <div class="trend-filter-bar">
        <span class="filter-label"><i class='bx bx-filter-alt'></i> Filtrar:</span>
        <div class="trend-filter-track">
          <button class="trend-filter-pill active" data-category="all">
            <i class='bx bx-grid-alt'></i> Todos
          </button>
          <button class="trend-filter-pill" data-category="Hombre">
            <i class='bx bx-male'></i> Hombres
          </button>
          <button class="trend-filter-pill" data-category="Mujer">
            <i class='bx bx-female'></i> Mujeres
          </button>
          <button class="trend-filter-pill" data-category="Niños">
            <i class='bx bx-smile'></i> Niños
          </button>
        </div>
      </div>

      <div class="products-grid" id="tendencias-grid">
        <div class="product-item-wrap" data-category="Hombre">
          <ProductCard
            title="Billetera de cuero elegante"
            price="S/ 50.00"
            image="/img/products/hombre/producto3h.jpg"
            rating="★★★★★"
            category="Hombre"
          />
        </div>
        <div class="product-item-wrap" data-category="Niños">
          <ProductCard
            title="Peluche Pablo Backyardigan"
            price="S/ 25.00"
            image="/img/products/ninhos/producto1n.jpg"
            rating="★★★★★"
            category="Niños"
          />
        </div>
        <div class="product-item-wrap" data-category="Mujer">
          <ProductCard
            title="Pulseras artesanales finas"
            price="S/ 5.00"
            image="/img/products/mujer/pulsera-1.png"
            rating="★★★★★"
            category="Mujer"
          />
        </div>
        <div class="product-item-wrap" data-category="Hombre">
          <ProductCard
            title="Reloj ejecutivo moderno"
            price="S/ 25.00"
            image="/img/products/hombre/producto1h.jpg"
            rating="★★★★★"
            category="Hombre"
          />
        </div>
        <div class="product-item-wrap" data-category="Niños">
          <ProductCard
            title="Peluche burro tierno"
            price="S/ 25.00"
            image="/img/products/ninhos/producto7n.jpg"
            rating="★★★★★"
            category="Niños"
          />
        </div>
      </div>
    </section>

    <!-- Colección Promociones -->
    <section class="collection-block promos-block">
      <div class="collection-header">
        <div class="header-left">
          <div class="badge-group">
            <span class="collection-badge badge-promo"><i class='bx bx-badge-check'></i> Oportunidades Especiales</span>
            <span class="discount-pill"><i class='bx bx-purchase-tag-alt'></i> Hasta 15% OFF</span>
          </div>
          <h2 class="collection-title"><i class='bx bx-purchase-tag'></i> Promociones Imperdibles</h2>
          <p class="collection-subtitle">Descuentos especiales por tiempo limitado en artículos seleccionados</p>
        </div>
        <div class="header-right">
          <span class="time-limit-badge"><i class='bx bx-time-five'></i> Ofertas por tiempo limitado</span>
        </div>
      </div>

      <div class="products-grid">
        <ProductCard
          title="Brazalete de plata brillante"
          price="S/ 45.00"
          image="/img/products/mujer/brazalete.png"
          rating="★★★★★"
          promo="15%"
          category="Mujer"
        />
        <ProductCard
          title="Collar dije de flecha"
          price="S/ 15.00"
          image="/img/products/hombre/producto2h.jpg"
          rating="★★★★★"
          promo="5%"
          category="Hombre"
        />
        <ProductCard
          title="Pulsera tribal tejida"
          price="S/ 15.00"
          image="/img/products/hombre/producto5h.jpg"
          rating="★★★★★"
          promo="2%"
          category="Hombre"
        />
        <ProductCard
          title="Aretes de diseño exclusivo"
          price="S/ 40.00"
          image="/img/products/mujer/aretes.jpg"
          rating="★★★★★"
          promo="10%"
          category="Mujer"
        />
        <ProductCard
          title="Set creativo de pinturas"
          price="S/ 20.00"
          image="/img/products/ninhos/producto6n.jpg"
          rating="★★★★★"
          promo="5%"
          category="Niños"
        />
      </div>
    </section>

    <!-- Acceso Rápido por Categorías -->
    <section class="collection-block categories-block">
      <div class="collection-header">
        <div class="header-left">
          <span class="collection-badge"><i class='bx bx-category'></i> Explorar por Colección</span>
          <h2 class="collection-title"><i class='bx bx-grid-alt'></i> Categorías</h2>
          <p class="collection-subtitle">Encuentra el detalle perfecto navegando en nuestras colecciones principales</p>
        </div>
      </div>
      <div class="category-cards-grid">
        <a href={getPath('/hombres')} class="cat-card">
          <div class="cat-card-icon-wrap">
            <i class='bx bx-male'></i>
          </div>
          <div class="cat-card-body">
            <h3>Hombres</h3>
            <p>Relojes, billeteras y accesorios</p>
            <span class="cat-link-text">Ver catálogo <i class='bx bx-right-arrow-alt'></i></span>
          </div>
        </a>
        <a href={getPath('/mujeres')} class="cat-card">
          <div class="cat-card-icon-wrap">
            <i class='bx bx-female'></i>
          </div>
          <div class="cat-card-body">
            <h3>Mujeres</h3>
            <p>Joyería fina, pulseras y anillos</p>
            <span class="cat-link-text">Ver catálogo <i class='bx bx-right-arrow-alt'></i></span>
          </div>
        </a>
        <a href={getPath('/ninhos')} class="cat-card">
          <div class="cat-card-icon-wrap">
            <i class='bx bx-smile'></i>
          </div>
          <div class="cat-card-body">
            <h3>Niños</h3>
            <p>Peluches y juguetes didácticos</p>
            <span class="cat-link-text">Ver catálogo <i class='bx bx-right-arrow-alt'></i></span>
          </div>
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Filtro interactivo en sección Tendencias
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.trend-filter-pill');
  const productWraps = document.querySelectorAll<HTMLElement>('#tendencias-grid .product-item-wrap');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const category = btn.getAttribute('data-category');

      productWraps.forEach((wrap) => {
        const wrapCat = wrap.getAttribute('data-category');
        if (category === 'all' || wrapCat === category) {
          wrap.style.display = 'block';
        } else {
          wrap.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  /* Hero */
  .hero-section {
    padding: 70px 0 50px 0;
  }

  .hero-container {
    display: flex;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fdf2ef;
    color: #DF7861;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 15px;
    border: 1px solid rgba(223, 120, 97, 0.2);
  }
  .hero-badge i {
    font-size: 1.05rem;
  }

  .hero-title {
    font-size: 3.4rem;
    font-weight: 800;
    color: #3e1908;
    line-height: 1.15;
    margin-bottom: 15px;
    letter-spacing: -1px;
  }

  .hero-title span {
    color: #DF7861;
  }

  .hero-slogan {
    font-size: 1.15rem;
    color: #64748b;
    margin-bottom: 30px;
    font-style: italic;
  }

  .hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .btn-hero-outline {
    display: inline-block;
    padding: 10px 24px;
    color: #3e1908;
    background: transparent;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 20px;
    border: 2px solid #3e1908;
    transition: all 0.3s ease;
  }

  .btn-hero-outline:hover {
    background: #3e1908;
    color: white;
  }

  /* Banner de temporada */
  .season-banner {
    background-blend-mode: overlay;
    background-size: cover;
    background-position: center;
    border-radius: 24px;
    padding: 45px 35px;
    color: white;
    margin: 40px 0 35px 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .season-content {
    max-width: 500px;
  }

  .season-tag {
    background: #f59e0b;
    color: #1f100a;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 12px;
  }

  .season-content h2 {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .season-content p {
    color: #cbd5e1;
    font-size: 1rem;
    margin-bottom: 22px;
    line-height: 1.5;
  }

  /* ========================================================
     Colecciones Generales (Containers & Headers)
     ======================================================== */
  .collection-block {
    border-radius: 24px;
    padding: 34px 30px;
    margin: 45px 0;
    transition: all 0.3s ease;
  }

  .collection-block .products-grid {
    margin: 15px 0 0 0;
  }

  /* Por Temporada */
  .temporada-block {
    background: linear-gradient(145deg, #ffffff 0%, #fff7f4 100%);
    border: 1px solid rgba(223, 120, 97, 0.22);
    box-shadow: 0 10px 30px rgba(223, 120, 97, 0.06);
  }

  /* Tendencias */
  .tendencias-block {
    background: #ffffff;
    border: 1px solid rgba(62, 25, 8, 0.08);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  /* Promociones */
  .promos-block {
    background: linear-gradient(145deg, #fffcfb 0%, #fdf3ef 100%);
    border: 1.5px dashed rgba(223, 120, 97, 0.45);
    box-shadow: 0 10px 30px rgba(223, 120, 97, 0.07);
  }

  /* Categorías */
  .categories-block {
    background: transparent;
    border: none;
    padding: 20px 0 40px 0;
    margin: 30px 0 10px 0;
  }

  /* Header de Colección */
  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .header-right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .collection-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fdf2ef;
    color: #DF7861;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 50px;
    border: 1px solid rgba(223, 120, 97, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }

  .collection-badge.badge-trend {
    background: #fef3c7;
    color: #b45309;
    border-color: rgba(180, 83, 9, 0.25);
  }

  .collection-badge.badge-promo {
    background: #fee2e2;
    color: #dc2626;
    border-color: rgba(220, 38, 38, 0.25);
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }

  .discount-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #ef4444;
    color: white;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 50px;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
  }

  .collection-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: #3e1908;
    margin: 2px 0 4px 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.5px;
  }

  .collection-title i {
    color: #DF7861;
    font-size: 1.7rem;
  }

  .collection-subtitle {
    color: #64748b;
    font-size: 0.98rem;
    margin: 0;
    line-height: 1.4;
  }

  .collection-chip, .time-limit-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: white;
    border: 1px solid rgba(223, 120, 97, 0.25);
    color: #3e1908;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .time-limit-badge i, .collection-chip i {
    color: #DF7861;
  }

  .collection-action-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #DF7861;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 50px;
    background: #fdf2ef;
    border: 1px solid rgba(223, 120, 97, 0.22);
    transition: all 0.25s ease;
  }

  .collection-action-link:hover {
    background: #DF7861;
    color: white;
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(223, 120, 97, 0.25);
  }

  /* Filtro de Tendencias */
  .trend-filter-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .filter-label {
    font-size: 0.88rem;
    font-weight: 700;
    color: #3e1908;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .trend-filter-track {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .trend-filter-track::-webkit-scrollbar {
    display: none;
  }

  .trend-filter-pill {
    background: #f8fafc;
    border: 1px solid rgba(0, 0, 0, 0.08);
    color: #475569;
    padding: 6px 15px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .trend-filter-pill i {
    font-size: 0.95rem;
    color: #DF7861;
  }

  .trend-filter-pill:hover {
    background: #fdf2ef;
    color: #DF7861;
    border-color: #DF7861;
  }

  .trend-filter-pill.active {
    background: #3e1908;
    color: white;
    border-color: #3e1908;
    box-shadow: 0 3px 10px rgba(62, 25, 8, 0.22);
  }

  .trend-filter-pill.active i {
    color: #DF7861;
  }

  .product-item-wrap {
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  /* Categorías preview */
  .category-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-top: 10px;
  }

  .cat-card {
    background: white;
    border-radius: 20px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .cat-card:hover {
    transform: translateY(-6px);
    border-color: #DF7861;
    box-shadow: 0 12px 28px rgba(223, 120, 97, 0.16);
  }

  .cat-card-icon-wrap {
    width: 62px;
    height: 62px;
    border-radius: 18px;
    background: #fdf2ef;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    transition: all 0.3s ease;
  }

  .cat-card-icon-wrap i {
    font-size: 2.2rem;
    color: #DF7861;
    transition: color 0.3s ease;
  }

  .cat-card:hover .cat-card-icon-wrap {
    background: #DF7861;
    transform: scale(1.08);
  }

  .cat-card:hover .cat-card-icon-wrap i {
    color: white;
  }

  .cat-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #3e1908;
    margin-bottom: 6px;
  }

  .cat-card p {
    font-size: 0.88rem;
    color: #64748b;
    margin-bottom: 14px;
    line-height: 1.4;
  }

  .cat-link-text {
    font-size: 0.84rem;
    font-weight: 700;
    color: #DF7861;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s ease;
  }

  .cat-card:hover .cat-link-text {
    gap: 8px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.4rem;
    }
    .season-content h2 {
      font-size: 1.7rem;
    }
    .collection-block {
      padding: 24px 18px;
      margin: 32px 0;
      border-radius: 20px;
    }
    .collection-title {
      font-size: 1.55rem;
    }
    .collection-title i {
      font-size: 1.45rem;
    }
    .category-cards-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .trend-filter-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .trend-filter-track {
      width: 100%;
      flex-wrap: nowrap;
    }
  }

  @media (max-width: 480px) {
    .collection-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .header-right {
      width: 100%;
    }
    .collection-action-link {
      width: 100%;
      justify-content: center;
    }
    .collection-block {
      padding: 20px 14px;
    }
  }
</style>
