---
import { getPath } from '../utils/paths';

interface Props {
  title: string;
  price: string;
  image: string;
  rating?: string;
  promo?: string;
  category?: string;
}

const { title, price, image, rating = "★★★★★", promo, category = "Accesorios" } = Astro.props;
const resolvedImage = getPath(image);
---

<div class="product-card" data-title={title} data-price={price} data-image={resolvedImage}>
  <div class="img-wrapper">
    <img src={resolvedImage} alt={title} loading="lazy" />
    {promo && <span class="promo-badge">-{promo}</span>}
    <span class="category-tag">{category}</span>
  </div>
  <div class="product-info">
    <div class="rating-stars">{rating}</div>
    <h3 class="product-title">{title}</h3>
    <div class="price-row">
      <span class="price-tag">{price}</span>
      <button class="add-cart-btn" title="Agregar al carrito">
        <i class='bx bx-cart-add'></i>
      </button>
    </div>
  </div>
</div>

<style>
  .product-card {
    background: #ffffff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(223, 120, 97, 0.18);
  }

  .img-wrapper {
    position: relative;
    width: 100%;
    height: 190px;
    background: #f8fafc;
    overflow: hidden;
  }

  .img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .img-wrapper img {
    transform: scale(1.08);
  }

  .promo-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ef4444;
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
  }

  .category-tag {
    position: absolute;
    bottom: 8px;
    left: 10px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(4px);
    color: #3e1908;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 6px;
  }

  .product-info {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .rating-stars {
    color: #f59e0b;
    font-size: 0.85rem;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .product-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #2d1810;
    margin-bottom: 10px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .price-tag {
    font-size: 1.1rem;
    font-weight: 700;
    color: #DF7861;
  }

  .add-cart-btn {
    background: #ca7c62;
    color: white;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.15rem;
    transition: all 0.2s ease;
  }

  .add-cart-btn:hover {
    background: #3e1908;
    transform: scale(1.1);
  }
</style>
