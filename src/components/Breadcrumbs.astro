---
import { getPath } from '../utils/paths';

export interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;
---

<nav class="site-container breadcrumbs-nav" aria-label="Ruta de navegación">
  <ol class="breadcrumbs-list">
    <li class="breadcrumb-item">
      <a href={getPath('/')} class="breadcrumb-link home-link" title="Ir al inicio">
        <i class='bx bx-home-alt'></i>
        <span>Inicio</span>
      </a>
    </li>
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumb-item">
          <i class='bx bx-chevron-right breadcrumb-separator'></i>
          {isLast || !item.href ? (
            <span class="breadcrumb-current" aria-current="page">
              {item.icon && <i class={item.icon}></i>}
              <span>{item.label}</span>
            </span>
          ) : (
            <a href={item.href} class="breadcrumb-link">
              {item.icon && <i class={item.icon}></i>}
              <span>{item.label}</span>
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .breadcrumbs-nav {
    padding: 15px 0 5px 0;
  }

  .breadcrumbs-list {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(8px);
    padding: 6px 16px;
    border-radius: 50px;
    border: 1px solid rgba(223, 120, 97, 0.15);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
  }

  .breadcrumb-link {
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
    font-weight: 500;
  }

  .breadcrumb-link:hover {
    color: #DF7861;
  }

  .home-link i {
    font-size: 1rem;
    color: #DF7861;
  }

  .breadcrumb-separator {
    color: #ca7c62;
    font-size: 1.05rem;
    opacity: 0.7;
  }

  .breadcrumb-current {
    color: #3e1908;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .breadcrumb-current i {
    color: #DF7861;
  }
</style>
