    text-decoration: none;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
    font-weight: 500;
  }
  .drawer-sub-item i {
    font-size: 1rem;
    color: #ca7c62;
  }
  .drawer-sub-item:hover {
    background: #fdf2ef;
    color: #DF7861;
    font-weight: 600;
  }
  .drawer-sub-item.view-all {
    color: #DF7861;
    font-weight: 700;
    margin-top: 2px;
