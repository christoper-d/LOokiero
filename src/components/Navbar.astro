  }

  /* Acordeón para colecciones en el Drawer */
  .drawer-accordion {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    transition: background 0.2s;
  }

  .drawer-accordion-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .accordion-title-link {
    flex-grow: 1;
  }

  .accordion-toggle-btn {
    background: transparent;
    border: none;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    color: #94a3b8;
