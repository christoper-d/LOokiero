---
---

<footer class="footer-wrapper">
  <div class="site-container footer-content">
    <div class="footer-col brand-col">
      <a href="/" class="logo">
        LOo<span>Kiero!</span>
      </a>
      <p class="slogan">"No dejes de hacer felices a los que quieres"</p>
      <div class="social-links">
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook"><i class='bx bxl-facebook'></i></a>
        <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="Twitter"><i class='bx bxl-twitter'></i></a>
        <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram"><i class='bx bxl-instagram'></i></a>
        <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn"><i class='bx bxl-linkedin'></i></a>
      </div>
    </div>

    <div class="footer-col links-col">
      <h4>Navegación</h4>
      <ul>
        <li><a href="/">Inicio</a></li>
        <li><a href="/hombres">Hombres</a></li>
        <li><a href="/mujeres">Mujeres</a></li>
        <li><a href="/ninhos">Niños</a></li>
        <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
        <li><a href="/sobre-nosotros#tyc">Términos y Condiciones</a></li>
      </ul>
    </div>

    <div class="footer-col map-col">
      <h4>Nuestra Ubicación</h4>
      <div class="map-container">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7805.287171872256!2d-77.07110077142714!3d-11.99914567350344!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105ce568c042771%3A0x6072f46c2b26e80!2sSENATI!5e0!3m2!1ses-419!2spe!4v1664680107465!5m2!1ses-419!2spe"
          width="100%"
          height="140"
          style="border:0; border-radius: 12px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="site-container">
      <p>LOokiero! &copy; {new Date().getFullYear()} - Todos los derechos reservados</p>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: #2d1810;
    color: #f1f5f9;
    margin-top: auto;
    padding-top: 50px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer-col h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 18px;
    color: #DF7861;
  }

  .brand-col .logo {
    color: #ffffff;
    font-size: 2rem;
    margin-bottom: 10px;
  }

  .brand-col .slogan {
    color: #cbd5e1;
    font-size: 0.95rem;
    margin-bottom: 20px;
    font-style: italic;
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-links a {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    transition: all 0.3s ease;
  }

  .social-links a:hover {
    background: #DF7861;
    transform: translateY(-3px);
  }

  .links-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .links-col a {
    color: #cbd5e1;
    font-size: 0.9rem;
    transition: color 0.2s, padding-left 0.2s;
  }

  .links-col a:hover {
    color: #DF7861;
    padding-left: 5px;
  }

  .footer-bottom {
    background: #1f100a;
    padding: 16px 0;
    text-align: center;
    font-size: 0.85rem;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
